# ============================================================
# GENERATED by nucleusd from /etc/nucleus/config.yaml — DO NOT EDIT.
# Multicast bridging between wlan1 (mesh) and br-lan (local LAN).
#
# Multi-hop propagation is handled natively by 802.11s at Layer 2:
#   - mesh_ttl (MESH_802_TTL) controls the hop limit
#   - RMC (Recent Multicast Cache) in mac80211 deduplicates by
#     (source address, mesh sequence number)
#
# smcroute's ONLY job is to bridge groups between wlan1 and br-lan. Routes are
# deliberately NO-ECHO (to <the other iface> only). Echoing back to the ingress
# interface caused exponential multicast amplification at 3+ nodes.
# See: Nucleus_OS docs/congestion_collision_tuning/mcast_storm_correction.md
# ============================================================

{% set groups = [
  ('239.2.3.1',      'ATAK CoT data'),
  ('224.10.10.1',    'ATAK Discovery'),
  ('239.255.255.1',  'ATAK Voice - general'),
  ('239.255.255.2',  'ATAK Voice - presence'),
  ('239.255.255.12', 'ATAK Voice - channel 1'),
] %}
{% for grp, desc in groups %}
# {{ desc }}
mgroup from wlan1 group {{ grp }}
mgroup from br-lan group {{ grp }}
mroute from wlan1 group {{ grp }} to br-lan
mroute from br-lan group {{ grp }} to wlan1
{% if halow_enabled %}
mgroup from {{ halow_iface }} group {{ grp }}
mroute from {{ halow_iface }} group {{ grp }} to br-lan
mroute from br-lan group {{ grp }} to {{ halow_iface }}
{% endif %}
{% if eth0_mcast_bridge %}
mgroup from eth0 group {{ grp }}
mroute from eth0 group {{ grp }} to br-lan
mroute from br-lan group {{ grp }} to eth0
{% endif %}
{% for radio in eth0_mcast_relay_ifaces %}
mroute from eth0 group {{ grp }} to {{ radio }}
mroute from {{ radio }} group {{ grp }} to eth0
{% endfor %}
{% endfor %}
{% if eth0_mcast_mode == "br_lan" %}
# eth0 (hard-line node link) <-> br-lan only, one-way each (no-echo). No
# eth0 <-> radio-mesh mroute (eth0.mcast_mode: br_lan). Unicast still crosses
# via Babel.
{% elif eth0_mcast_mode == "mesh_relay" %}
# eth0.mcast_mode: mesh_relay — this node relays eth0 <-> {{ eth0_mcast_relay_ifaces | join(", ") }}
# (no-echo, one-way each) for RF-silent nodes on the wire. Constraint: at most
# ONE mesh_relay node per eth0 segment, and nodes on the wire must not transmit
# on the same radio mesh, else multicast loops wire <-> mesh until TTL expiry.
{% endif %}
{% if halow_enabled %}
# NOTE: deliberately NO wlan1<->halow0 mroute. Bridging multicast between the two
# meshes would risk a cross-mesh storm; HaLow<->WiFi multicast relay is deferred
# (docs/halow.md §10.9). Unicast still crosses via Babel. Each halow0<->br-lan
# route above is one-way (no-echo), same rule as wlan1<->br-lan.
{% endif %}
