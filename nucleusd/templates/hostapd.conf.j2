# ============================================================
# GENERATED by nucleusd from /etc/nucleus/config.yaml — DO NOT EDIT.
# Onboard AP on wlan0 (5 GHz), bridged directly into br-lan.
#
# hostapd adds wlan0 to br-lan itself (bridge= directive) — this replaces the
# old brlan-setup.service sleep+`ip link set master` hack.
# ============================================================

interface=wlan0
bridge=br-lan
ssid={{ ap_name }}
hw_mode=a
channel={{ ap_channel }}
auth_algs=1
wmm_enabled=1
wpa=2
wpa_passphrase={{ ap_password }}
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
