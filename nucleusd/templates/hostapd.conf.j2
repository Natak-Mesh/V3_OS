# ============================================================
# GENERATED by nucleusd from /etc/nucleus/config.yaml — DO NOT EDIT.
# Onboard AP on wlan0 (5 GHz), bridged into br-lan.
#
# NOTE: wlan0 is enslaved to br-lan by systemd-networkd via the
# `Bridge=br-lan` directive in 30-wlan0.network (matching the known-good v2
# setup). Do NOT add a `bridge=` line here — having both hostapd and networkd
# enslave wlan0 makes networkd fail with "Device does not allow enslaving to a
# bridge" and the interface lands in the failed state.
# ============================================================

interface=wlan0
ssid={{ ap_name }}
hw_mode=a
channel={{ ap_channel }}
auth_algs=1
wmm_enabled=1
wpa=2
wpa_passphrase={{ ap_password }}
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
