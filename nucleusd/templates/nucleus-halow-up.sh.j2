#!/bin/bash
# ============================================================
# GENERATED by nucleusd from /etc/nucleus/config.yaml — DO NOT EDIT.
# Wi-Fi HaLow (802.11ah) 802.11s mesh bring-up on {{ halow_iface }}.
# Run by nucleus-halow.service (oneshot), started from the udev rule when the
# Morse MM8108 radio appears (renamed to {{ halow_iface }}).
#
# The driver, firmware and wpa_supplicant_s1g are installed system-wide by
# nucleus-halow-build.sh, so there is NO insmod and NO firmware-path sysfs
# override here (docs/halow.md §10.6) — the module autoloads on plug. This script
# does only the imperative mesh join + kernel mesh params, mirroring
# nucleus-mesh-up.sh and its hard-won lessons (docs/halow.md §7).
# ============================================================
set -euo pipefail

IF="{{ halow_iface }}"
CONF="/etc/wpa_supplicant/wpa_supplicant-halow.conf"
SUPPLICANT="/opt/nucleus/bin/wpa_supplicant_s1g"

# Hand the HaLow interface to us, not NetworkManager (also listed in the
# NM unmanaged-devices.conf; this covers a hot-plug before NM re-reads it).
nmcli device set "$IF" managed no 2>/dev/null || true

# Keep the deterministic fe80 link-local across link-down events, or Babel marks
# the interface down after a bounce (same lesson as wlan1).
sysctl -w net.ipv6.conf."$IF".keep_addr_on_down=1 2>/dev/null || true

# --- Make this script safe to re-run (apply without reboot / replug) ---------
# A stale supplicant still bound to the interface makes the join below fail,
# which under `set -euo pipefail` aborts before the mesh params. Kill any
# existing instance, wait for it to release the interface, drop its ctrl socket.
pkill -f "wpa_supplicant_s1g .*-i $IF" || true
for _ in $(seq 1 10); do
    pgrep -f "wpa_supplicant_s1g .*-i $IF" >/dev/null || break
    sleep 0.5
done
rm -f /run/wpa_supplicant_s1g/"$IF"

# Clear any stale kernel mesh id so the kernel can't auto-rejoin on link-up
# (the error=-114 "already joined" lesson, docs/halow.md §7).
ip link set "$IF" down
iw dev "$IF" set type managed

# Start the Morse fork supplicant — the only one that actually starts the
# firmware mesh (docs/halow.md §5).
"$SUPPLICANT" -B -D nl80211 -i "$IF" -c "$CONF"

# (Re-)assert the networkd config (static IP + fe80) now the link exists.
networkctl reconfigure "$IF" || true

# Let the mesh establish before applying params.
sleep 5

# Disable HWMP L2 forwarding — Babel handles all routing at L3.
iw dev "$IF" set mesh_param mesh_fwding=0
{% if halow_802_ttl > 0 %}
# 802.11s L2 TTL: hop limit for native multicast forwarding (kernel default 31
# is far too high). mac80211 dedups via RMC. Shared with the wlan1 mesh value.
iw dev "$IF" set mesh_param mesh_ttl={{ halow_802_ttl }}
iw dev "$IF" set mesh_param mesh_element_ttl={{ halow_802_ttl }}
{% endif %}

echo "nucleus-halow: $IF mesh up ({{ halow_ssid }} S1G ch {{ halow_channel }}/{{ halow_bandwidth_mhz }}MHz op{{ halow_op_class }}, ip {{ halow_ip }})"
