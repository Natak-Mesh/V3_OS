# wlan1 carries a static mesh IP. LinkLocalAddressing=no so networkd does not
# fight the deterministic fe80 address we set for Babel.
[Match]
Name=wlan1

[Network]
Address={{ mesh_ip }}/24
Address={{ mesh_ipv6_ll }}/64
LinkLocalAddressing=no
IPv6AcceptRA=no
ConfigureWithoutCarrier=yes
