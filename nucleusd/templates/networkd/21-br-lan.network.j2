# GENERATED by nucleusd — DO NOT EDIT.
# br-lan holds the AP (wlan0) and eth0-LAN clients; serves DHCP to them.
[Match]
Name=br-lan

[Network]
Address={{ br_lan_ip }}/24
Address={{ br_lan_ipv6_ll }}/64
LinkLocalAddressing=no
IPv6AcceptRA=no
DHCPServer=yes

[DHCPServer]
PoolOffset={{ br_lan_dhcp_offset }}
PoolSize={{ br_lan_dhcp_size }}
EmitDNS=yes
DNS={{ br_lan_dns }}
EmitRouter=yes
