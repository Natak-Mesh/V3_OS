#!/bin/bash
# ============================================================
# GENERATED by nucleusd from /etc/nucleus/config.yaml — DO NOT EDIT.
# Host firewall (UFW) + eth0 WAN NAT. Run by nucleus-firewall.service (oneshot).
#
# Deliberately INDEPENDENT of the mesh radio: ordered only After=
# systemd-networkd, with no wlan1 device dependency. The firewall (incl. the
# eth0 Reticulum UDP ports and NAT/route rules) must apply even when wlan1 is
# RF-killed or the mesh never comes up — which is why it no longer lives in
# nucleus-mesh-up.sh (that aborts under `set -euo pipefail` if the mesh join
# fails, before it could reach these rules).
# ============================================================
set -euo pipefail

# --- eth0 WAN NAT (nftables) ------------------------------------------------
# Own table, rebuilt every run so a mode/config change takes effect. Traffic to
# Nucleus nets and multicast is NOT masqueraded: it crosses eth0 as a hard-line
# node link (Babel-routed / smcroute-bridged) and must keep its real source.
nft delete table ip nucleus_nat 2>/dev/null || true
# Drop the legacy unconditional masquerade earlier releases put in `ip nat`.
for h in $(nft -a list chain ip nat POSTROUTING 2>/dev/null | awk '/oifname "eth0" masquerade/{print $NF}'); do
    nft delete rule ip nat POSTROUTING handle "$h" || true
done
{% if eth0_mode == "wan" %}
# NAT for internet gateway sharing (WAN mode).
nft -f - <<'EOF' || echo "nucleus-firewall: WARNING: eth0 NAT rules failed to load" >&2
table ip nucleus_nat {
    chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        oifname "eth0" ip daddr != { {{ nat_exempt_dsts_nft }} } masquerade comment "nucleus_wan_nat"
    }
}
EOF
{% endif %}

# --- ATAK multicast TTL bump (nftables) -------------------------------------
# ATAK emits CoT/discovery/voice with TTL=1; the kernel won't forward multicast
# unless TTL>1, so smcroute could not bridge it without this. Lives here (not in
# nucleus-mesh-up.sh) so it applies with the wlan1 mesh off — the eth0 hard line
# needs it too. Own table, rebuilt every run so a config change takes effect.
nft delete table ip nucleus_mcast 2>/dev/null || true
# Drop the legacy rules nucleus-mesh-up.sh used to add to `ip mangle`.
for h in $(nft -a list chain ip mangle PREROUTING 2>/dev/null | awk '/nucleus_mcast_ttl/{print $NF}'); do
    nft delete rule ip mangle PREROUTING handle "$h" || true
done
{% if mcast_ttl_ingress %}
nft -f - <<'EOF' || echo "nucleus-firewall: WARNING: multicast TTL rules failed to load" >&2
table ip nucleus_mcast {
    chain prerouting {
        type filter hook prerouting priority -150; policy accept;
{% for r in mcast_ttl_ingress %}
        iifname "{{ r.iface }}" ip daddr { {{ atak_mcast_dsts_nft }} }{% if r.only_ttl1 %} ip ttl 1{% endif %} ip ttl set {{ mesh_mcast_ttl }} comment "nucleus_mcast_ttl"
{% endfor %}
    }
}
EOF
{% endif %}

# --- Host firewall (UFW) ----------------------------------------------------
{% if firewall_enabled %}
# config.yaml is the single source of truth: reset first so the live ruleset is
# rebuilt from the current config on every run and never accumulates stale rules
# from an earlier apply. `ufw --force reset` only clears UFW's own rules — the
# nftables NAT masquerade, the multicast-TTL table (ip nucleus_mcast, above),
# and Tailscale's chains live in separate tables and are untouched. Reset
# leaves timestamped backups of the rule files behind; drop them so /etc/ufw
# does not fill up over time.
ufw --force reset
rm -f /etc/ufw/*.rules.[0-9]*_[0-9]*
# Trust internal interfaces (WPA3 mesh + local LAN + tailscale); default-deny
# everything arriving on eth0 EXCEPT ssh, so ethernet admin access survives.
# The ssh-on-eth0 rule is added first, right after the reset, so admin access
# over ethernet is never left dangling by a later bad rule.
ufw --force default deny incoming
ufw --force default allow outgoing
ufw --force default deny routed
ufw allow in on eth0 to any port 22 proto tcp comment 'ssh over ethernet'
# Reticulum AutoInterface over eth0 (wired/fiber peering): discovery, unicast
# discovery, and data UDP ports must be open or peers never form over eth0.
ufw allow in on eth0 to any port 29716 proto udp comment 'reticulum autointerface discovery'
ufw allow in on eth0 to any port 29717 proto udp comment 'reticulum autointerface unicast discovery'
ufw allow in on eth0 to any port 42671 proto udp comment 'reticulum autointerface data'
{% if eth0_babel %}
# Babel over eth0 (hard-line node link): hellos/updates on UDP 6696.
ufw allow in on eth0 to any port 6696 proto udp comment 'babel over ethernet'
{% endif %}
{% if eth0_mcast_bridge %}
# ATAK multicast arriving over eth0 (hard-line node link), any port.
{% for dst in atak_mcast_dsts %}
ufw allow in on eth0 to {{ dst }} comment 'atak multicast over ethernet'
{% endfor %}
{% endif %}
ufw allow in on wlan1
ufw allow in on br-lan
ufw allow in on tailscale0
{% if halow_enabled %}
# Wi-Fi HaLow mesh (halow0) — trusted like wlan1. These are persistent now,
# replacing the ad-hoc `ufw allow in on wlan2` rules the manual bring-up left
# (wiped by the next `ufw --force reset`).
ufw allow in on {{ halow_iface }}
{% endif %}
{% if web_eth0_access %}
# Web UI over ethernet (home LAN etc). nginx password-protects any request that
# does not come from a trusted source net (mesh/br-lan/tailscale). Port 8080
# (the raw app) stays closed on eth0 — only the nginx proxy (80/443) is exposed.
ufw allow in on eth0 to any port 80 proto tcp comment 'web ui over ethernet'
ufw allow in on eth0 to any port 443 proto tcp comment 'web ui (https) over ethernet'
{% endif %}

# Official TAK Server: open its ports on eth0 whenever the package is installed.
# Checked at run time (dpkg), not from config, so it tracks what is actually on
# the node — nodes without TAK open nothing extra. Exact string compare (no
# pipeline) so `set -euo pipefail` can't abort on a missing package.
# 8443/8089/8090 require a client cert; 8446 (enrollment) is user/password.
if [ "$(dpkg-query -W -f='${Status}' takserver 2>/dev/null)" = "install ok installed" ]; then
    ufw allow in on eth0 to any port 8443 proto tcp comment 'tak web admin'
    ufw allow in on eth0 to any port 8089 proto tcp comment 'tak client tls'
    ufw allow in on eth0 to any port 8446 proto tcp comment 'tak cert enrollment'
    ufw allow in on eth0 to any port 8090 proto udp comment 'tak quic'
fi
# OpenTAKServer (either/or with the official server; installed manually, not a
# .deb): open its TLS ports on eth0 whenever its unit is enabled. The plain-HTTP
# 8082 (unauthenticated Marti API) is deliberately NOT opened on eth0.
if systemctl is-enabled --quiet opentakserver.service 2>/dev/null; then
    ufw allow in on eth0 to any port 8444 proto tcp comment 'ots web ui'
    ufw allow in on eth0 to any port 8443 proto tcp comment 'ots marti api'
    ufw allow in on eth0 to any port 8446 proto tcp comment 'ots cert enrollment'
    ufw allow in on eth0 to any port 8089 proto tcp comment 'ots client tls'
    ufw allow in on eth0 to any port 8883 proto tcp comment 'ots mqtt tls'
    ufw allow in on eth0 to any port 8322 proto tcp comment 'ots rtsps'
    ufw allow in on eth0 to any port 1936 proto tcp comment 'ots rtmps'
fi
# MediaMTX (installed by nucleus-tak-setup.sh, not a .deb): open RTSP + SRT on
# eth0 whenever its unit is enabled. `if` keeps a non-zero exit from tripping -e.
if systemctl is-enabled --quiet mediamtx.service 2>/dev/null; then
    ufw allow in on eth0 to any port 8554 proto tcp comment 'mediamtx rtsp'
    ufw allow in on eth0 to any port 8000 proto udp comment 'mediamtx rtp'
    ufw allow in on eth0 to any port 8001 proto udp comment 'mediamtx rtcp'
    ufw allow in on eth0 to any port 8890 proto udp comment 'mediamtx srt'
fi
{% if eth0_mode == "wan" %}
# WAN mode: let LAN/mesh clients route OUT to the internet via eth0. NAT
# masquerade for these is set up in the WAN block above; inbound-from-internet
# forwarding stays denied by the default deny-routed policy (established replies
# are still permitted by conntrack).
ufw route allow in on br-lan out on eth0
ufw route allow in on wlan1 out on eth0
{% if halow_enabled %}
ufw route allow in on {{ halow_iface }} out on eth0
{% endif %}
{% endif %}
# Always allow mesh <-> LAN forwarding regardless of eth0 mode.
ufw route allow in on br-lan out on wlan1
ufw route allow in on wlan1 out on br-lan
{% if halow_enabled %}
ufw route allow in on br-lan out on {{ halow_iface }}
ufw route allow in on {{ halow_iface }} out on br-lan
{% endif %}
{% if eth0_link_routes %}
# Hard-line node link over eth0: Babel-routed unicast between eth0 and the
# internal links (Nucleus nets only, so upstream WAN hosts stay out) and bridged
# ATAK multicast eth0 <-> br-lan. In WAN mode `<iface> -> eth0` is already
# allowed above, so only the inbound direction is listed.
{% for r in eth0_link_routes %}
ufw route allow in on {{ r.in }} out on {{ r.out }}{% if r.src %} from {{ r.src }}{% endif %}{% if r.dst %} to {{ r.dst }}{% endif %} comment 'eth0 node link'
{% endfor %}
{% endif %}
ufw --force enable
{% else %}
# Firewall disabled in config (firewall.enabled: false) — turn UFW off entirely.
ufw --force disable
{% endif %}

echo "nucleus-firewall: ufw applied (eth0 {{ eth0_mode }} mode)"
