# Rendered by nucleusd — DO NOT EDIT. Source: /etc/nucleus/config.yaml
# Reticulum daemon (rnsd) config. Regenerate with `nucleusctl apply`.

[reticulum]
  enable_transport = {{ "Yes" if reti_transport else "No" }}
  share_instance = Yes
  instance_name = default

[logging]
  loglevel = {{ reti_loglevel }}

[interfaces]

{% if reti_auto_interface %}
  [[Mesh AutoInterface]]
    type = AutoInterface
    enabled = Yes
    # full (not internal): internal mode suppresses announce/path propagation,
    # which is only correct for co-located shared-instance links. eth0/wlan1
    # peers are real neighbours, so announces and paths must flow over them.
    mode = full
    devices = {{ reti_auto_devices }}

{% endif %}
{% if reti_tcp_server %}
  [[LAN TCP Server]]
    type = TCPServerInterface
    enabled = Yes
    mode = internal
    device = {{ reti_tcp_server_device }}
    listen_port = {{ reti_tcp_server_port }}

{% endif %}
{#- Entry Node (public-IP TCP uplink) commented out: force mesh/eth0-only peering.
{% if reti_entry_node %}
  [[Entry Node]]
    # boundary: announces from the public network are NOT flooded into the
    # mesh/LAN; local announces still propagate out, and internal clients can
    # still resolve outside paths on demand (recursive path requests).
    type = TCPClientInterface
    enabled = Yes
    mode = boundary
    target_host = {{ reti_entry_node_host }}
    target_port = {{ reti_entry_node_port }}

{% endif %}
-#}
{% if reti_rnode_enabled %}
  [[RNode LoRa]]
    type = RNodeInterface
    enabled = Yes
    port = {{ reti_rnode_port }}
    frequency = {{ reti_rnode_frequency }}
    bandwidth = {{ reti_rnode_bandwidth }}
    txpower = {{ reti_rnode_txpower }}
    spreadingfactor = {{ reti_rnode_spreadingfactor }}
    codingrate = {{ reti_rnode_codingrate }}

{% endif %}
{% if reti_modem73_enabled %}
  [[MODEM73 Soundmodem]]
    # KISS-on-TCP to the local modem73 soundmodem (aicodix OFDM over a USB sound
    # device + serial PTT). kiss_framing is only safe here because this socket
    # only ever talks to modem73, never to our own br-lan TCPServer. fixed_mtu /
    # bitrate tell RNS this is a slow radio link so it frames/times correctly.
    type = TCPClientInterface
    enabled = Yes
    kiss_framing = True
    target_host = {{ reti_modem73_host }}
    target_port = {{ reti_modem73_port }}
    fixed_mtu = {{ reti_modem73_fixed_mtu }}
    bitrate = {{ reti_modem73_bitrate }}

{% endif %}
