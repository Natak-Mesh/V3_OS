# ============================================================
# GENERATED by nucleusd from /etc/nucleus/config.yaml — DO NOT EDIT.
# SAE/WPA3-encrypted 802.11s mesh join on wlan1.
#
# mode=5 = 802.11s mesh point. mesh_fwding=0 disables HWMP L2 forwarding so
# Babel owns all L3 routing. ieee80211w=2 = management frame protection (SAE).
# ============================================================

ctrl_interface=/var/run/wpa_supplicant
update_config=1
ap_scan=0
country={{ mesh_country }}

network={
    ssid="{{ mesh_ssid }}"
    mode=5
    frequency={{ mesh_frequency }}
    key_mgmt=SAE
    psk="{{ mesh_password }}"
    mesh_fwding=0
    ieee80211w=2
}
