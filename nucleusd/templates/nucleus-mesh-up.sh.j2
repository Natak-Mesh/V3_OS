#!/bin/bash
# ============================================================
# GENERATED by nucleusd from /etc/nucleus/config.yaml — DO NOT EDIT.
# 802.11s mesh bring-up on wlan1. Run by nucleus-mesh.service (oneshot).
#
# systemd-networkd owns the DECLARATIVE bits (br-lan, addresses, DHCP). This
# script does only the IMPERATIVE bits that networkd cannot express: putting
# wlan1 into 802.11s mesh mode, the SAE join, kernel mesh params, and the
# nftables multicast-TTL mangle rule. The host firewall (UFW) and eth0 WAN NAT
# live in nucleus-firewall.sh / nucleus-firewall.service, decoupled from this
# radio-dependent unit so they apply even when wlan1 is RF-killed.
# ============================================================
set -euo pipefail

sysctl -w net.ipv4.ip_forward=1

# Hand the mesh/AP interfaces to us, not NetworkManager.
for dev in eth0 wlan0 wlan1 br-lan; do
    nmcli device set "$dev" managed no 2>/dev/null || true
done

# --- Make this script safe to re-run (apply without reboot) -----------------
# A stale wpa_supplicant still bound to wlan1 makes the join below fail, which
# under `set -euo pipefail` aborts the script before the multicast-TTL mangle
# section. Kill any existing instance, wait for it to release the interface,
# and drop its control socket so the fresh -B launch starts clean.
pkill -f 'wpa_supplicant .*-i wlan1' || true
for _ in $(seq 1 10); do
    pgrep -f 'wpa_supplicant .*-i wlan1' >/dev/null || break
    sleep 0.5
done
rm -f /var/run/wpa_supplicant/wlan1

# Keep wlan1's IPv6 link-local across link-down events. Toggling the mesh radio
# off/on (rfkill) bounces the link; by default the kernel DROPS the deterministic
# fe80 address networkd set for Babel, and networkd does not re-add it on carrier
# return. Babel then marks wlan1 down ("no link-local address") and this node
# vanishes from the mesh. keep_addr_on_down=1 makes the address survive the bounce.
sysctl -w net.ipv6.conf.wlan1.keep_addr_on_down=1

# --- Put wlan1 into encrypted 802.11s mesh mode -----------------------------
ip link set wlan1 down
iw reg set "{{ mesh_country }}"
iw dev wlan1 set type managed
iw dev wlan1 set 4addr on
iw dev wlan1 set type mesh
iw dev wlan1 set meshid {{ mesh_ssid }}
iw dev wlan1 set channel {{ mesh_channel }} HT20
ip link set wlan1 up

# SAE/WPA3 encryption for the mesh.
wpa_supplicant -B -i wlan1 -c /etc/wpa_supplicant/wpa_supplicant-mesh.conf

# Re-assert the networkd config (static IP + fe80 link-local) in case the link
# bounced out from under it; without the fe80 address Babel won't use wlan1.
networkctl reconfigure wlan1 || true

# Wait for the mesh to establish before applying params.
sleep 15

# Disable HWMP L2 forwarding — Babel handles all routing at L3. Some drivers
# ignore the mesh_fwding=0 in wpa_supplicant.conf, so force it here.
iw dev wlan1 set mesh_param mesh_fwding=0

{% if mesh_802_ttl > 0 %}
# 802.11s L2 TTL: hop limit for native multicast forwarding (kernel default 31
# is far too high). mac80211 dedups via RMC. See mcast_storm_correction.md.
iw dev wlan1 set mesh_param mesh_ttl={{ mesh_802_ttl }}
iw dev wlan1 set mesh_param mesh_element_ttl={{ mesh_802_ttl }}
{% endif %}

{% if mesh_rts_threshold > 0 %}
# RTS/CTS for collision avoidance (hidden-node / 3+ node scenarios).
MESH_PHY=$(iw dev wlan1 info | awk '/wiphy/{print "phy"$2}')
iw phy "$MESH_PHY" set rts {{ mesh_rts_threshold }}
{% endif %}

{% if mesh_mcast_ttl > 0 %}
# Bump multicast TTL on br-lan ingress. ATAK emits CoT/discovery/voice with
# TTL=1; the kernel won't forward multicast unless TTL>1, so smcroute could not
# bridge br-lan -> wlan1 without this. Only br-lan ingress is mangled; traffic
# arriving from the mesh on wlan1 already has adequate TTL.
nft list table ip mangle 2>/dev/null | grep -q 'nucleus_mcast_ttl' || {
    nft add table ip mangle 2>/dev/null || true
    nft 'add chain ip mangle PREROUTING { type filter hook prerouting priority -150 ; }' 2>/dev/null || true
    nft add rule ip mangle PREROUTING iifname "br-lan" ip daddr 239.2.3.1 ip ttl set {{ mesh_mcast_ttl }} comment \"nucleus_mcast_ttl\"
    nft add rule ip mangle PREROUTING iifname "br-lan" ip daddr 224.10.10.1 ip ttl set {{ mesh_mcast_ttl }} comment \"nucleus_mcast_ttl\"
    nft add rule ip mangle PREROUTING iifname "br-lan" ip daddr 239.255.255.0/24 ip ttl set {{ mesh_mcast_ttl }} comment \"nucleus_mcast_ttl\"
}
{% endif %}

echo "nucleus-mesh: wlan1 mesh up ({{ mesh_ssid }} ch {{ mesh_channel }}, ip {{ mesh_ip }})"
