# ============================================================
# GENERATED by nucleusd from /etc/nucleus/config.yaml — DO NOT EDIT.
# Reverse proxy so the web UI is reachable at http(s)://{{ hostname }}.local
# (and by bare IP) with no :8080 port. Proxies to the uvicorn app on :8080.
#
# Two server blocks, both default_server (V3 nodes run no other vhost):
#   - port 80  (HTTP)
#   - port 443 (HTTPS) — most browsers auto-upgrade a typed hostname to https,
#     so this block is what phones/desktops actually hit. Uses our own
#     self-signed cert (see nucleus-web.crt/key).
# Direct http://<ip>:8080 keeps working unchanged as a fallback.
# ============================================================

# Rate-limit zone for web-UI logins (shared across both server blocks). Declared
# here at http context — this file is included inside nginx's http {} block.
limit_req_zone $binary_remote_addr zone=nucleus_login:1m rate=10r/s;

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name {{ hostname }}.local _;

    # --- Web UI access control -------------------------------------------------
    # Trusted source networks (mesh, br-lan/AP, tailscale, localhost) reach the
    # UI with no password. Everything else — i.e. clients arriving over eth0 —
    # must pass HTTP Basic auth. `satisfy any` = allowed source OR valid login.
    satisfy any;
    allow 127.0.0.1;
    allow ::1;
{% for cidr in web_trusted_cidrs %}
    allow {{ cidr }};
{% endfor %}
    deny all;
    auth_basic "nucleus";
    auth_basic_user_file /etc/nginx/nucleus.htpasswd;
    # Throttle password guessing from exposed (eth0) clients.
    limit_req zone=nucleus_login burst=20 nodelay;

    # Mesh PTT voice: soft-PTT handset WebSocket → nucleus-voice daemon (:5557).
    location /voice-ws {
        proxy_pass http://127.0.0.1:5557;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Live chat push: messaging WebSocket → uvicorn app (long-lived, idle).
    location /api/v1/messaging/ws {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket upgrade (FastAPI endpoints may use ws).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    server_name {{ hostname }}.local _;

    # --- Web UI access control (see the port-80 block above) -------------------
    satisfy any;
    allow 127.0.0.1;
    allow ::1;
{% for cidr in web_trusted_cidrs %}
    allow {{ cidr }};
{% endfor %}
    deny all;
    auth_basic "nucleus";
    auth_basic_user_file /etc/nginx/nucleus.htpasswd;
    limit_req zone=nucleus_login burst=20 nodelay;

    ssl_certificate /etc/nucleus/certs/nucleus-web.crt;
    ssl_certificate_key /etc/nucleus/certs/nucleus-web.key;

    # Mesh PTT voice: soft-PTT handset WebSocket → nucleus-voice daemon (:5557).
    # HTTPS is required for browser mic access, so this block is the real path.
    location /voice-ws {
        proxy_pass http://127.0.0.1:5557;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Live chat push: messaging WebSocket → uvicorn app (long-lived, idle).
    location /api/v1/messaging/ws {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
