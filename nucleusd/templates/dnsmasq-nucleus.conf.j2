# DNS only (no DHCP; networkd serves DHCP) for clients on br-lan. Answers this
# node's .local names itself so they resolve with no internet; everything else
# is forwarded to br_lan.dns.
interface=br-lan
except-interface=lo
bind-dynamic
no-dhcp-interface=br-lan
no-resolv
no-hosts
server={{ br_lan_dns }}
host-record={{ local_names | join(",") }},{{ br_lan_ip }}
