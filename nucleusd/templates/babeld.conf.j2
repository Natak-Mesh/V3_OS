# ============================================================
# GENERATED by nucleusd from /etc/nucleus/config.yaml — DO NOT EDIT.
# Babel L3 routing for the Nucleus mesh.
#
# 802.11s L2 forwarding (HWMP) is DISABLED (mesh_fwding=0); Babel owns all
# unicast routing at L3. Multicast is bridged separately by smcroute.
# ============================================================

# Kernel route installation
import-table 254
export-table 254

# Local monitoring interface (read-only; used by `nucleusctl status`)
local-port 33123

# Wireless mesh interface (wlan1)
interface wlan1 type wireless link-quality true split-horizon false rxcost 256 hello-interval 4 update-interval 16

# Wired bridge interface (br-lan)
interface br-lan type wired rxcost 96 hello-interval 4

{% if halow_enabled %}
# Wi-Fi HaLow (802.11ah) mesh interface (halow0). babeld treats a missing iface
# as down, so this is harmless on a node without the HaLow radio.
interface {{ halow_iface }} type wireless link-quality true split-horizon false rxcost 256 hello-interval 4 update-interval 16
{% endif %}

# Block router LAN networks from being redistributed (prevents asymmetric routing)
redistribute ip 192.168.0.0/16 deny

# Redistribute local mesh network
redistribute ip {{ mesh_subnet }} allow

# Redistribute br-lan network
redistribute ip {{ br_lan_subnet }} allow

{% if halow_enabled %}
# Redistribute the HaLow mesh network (10.30.1.0/24)
redistribute ip 10.30.1.0/24 allow
{% endif %}

# Redistribute default route for internet gateway sharing
redistribute ip 0.0.0.0/0 allow

# Block default local address /32 export (must come after allow rules)
redistribute local deny

# Default deny to prevent redistributing unwanted routes
redistribute deny
